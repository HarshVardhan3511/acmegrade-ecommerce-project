# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Database
DB_FILE=./shopeasy.db
UPLOAD_DIR=./public/uploads

# Optional email delivery (SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional SMS delivery (Twilio; use an E.164 phone number on each customer profile)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
